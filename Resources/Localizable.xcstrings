    "フリックのキーボードでは削除%@キーを左にフリックすると、文頭まで削除することができます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In flick input, flick the delete key %@ to the left to delete up to the beginning of the sentence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nell'input a flick, fai scorrere verso sinistra il tasto elimina %@ per eliminare fino all'inizio della frase."
          }
        }
      }
    },
    "フリックの感度" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flicking sensitivity"
          }
