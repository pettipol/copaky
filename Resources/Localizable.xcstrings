    },
    "設定を有効化できません" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This setting cannot be enabled"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è possibile attivare questa impostazione"
          }
        }
      }
    },
    "許可しないと、「クリップボードの履歴」タブがクリップボードを読み取るたびに、iOSのペースト確認ダイアログが表示されます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without this permission, iOS shows a paste confirmation dialog each time the Clipboard History tab reads the clipboard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza questa autorizzazione, iOS mostra una finestra di dialogo per confermare l'incolla ogni volta che la scheda Cronologia degli appunti legge gli appunti."
          }
        }
      }
    },
    "詳しい設定" : {
