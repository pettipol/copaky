            "value" : "Condividi link"
          }
        }
      }
    },
    "レポートに左右の文脈を自動で含めます。左右それぞれ10文字程度まででカットされるので、すべての文章が送信されることはありません。都度、確認画面で含めないよう変更することもできます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically include about ten characters of context on each side of the report. The entire text is never sent, and you can choose to exclude it on the confirmation screen each time."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La segnalazione include automaticamente il contesto a sinistra e a destra, troncato a circa 10 caratteri per lato: il testo completo non viene mai inviato. Puoi comunque scegliere di escluderlo di volta in volta nella schermata di conferma."
          }
        }
      }
    },
    "ローマ字かな入力" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roman to kana input style"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
