    "「2020ねん→令和2年」「れいわ2ねん→2020年」のように西暦と和暦を相互に変換して候補に表示します。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convert between Western and Japanese calendar years and display candidates such as '2020ねん → 令和2年' and 'れいわ2ねん → 2020年'."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converte tra anno solare occidentale ed era giapponese, mostrando candidati come «2020ねん → 令和2年» e «れいわ2ねん → 2020年»."
          }
        }
      }
    },
    "「u3042→あ」のように、入力されたunicode番号に対応する文字に変換します。接頭辞にはu, u+, U, U+が使えます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converts an entered Unicode code point to the corresponding character, e.g., 'u3042' → 'あ'. Prefixes u, u+, U, and U+ are supported."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Converte il numero Unicode inserito nel carattere corrispondente, ad esempio «u3042 → あ». Sono supportati i prefissi u, u+, U e U+."
          }
        }
      }
    },
    "「Zenzai」はCopakyの新しいかな漢字変換システムです。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zenzai is Copaky’s new kana-kanji conversion system."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Zenzai» è il nuovo sistema di conversione kana-kanji di Copaky."
          }
        }
      }
    },
    "「Zenzaiを有効化」をONにしてお試しください" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on 'Enable Zenzai' to try it."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva «Abilita Zenzai» per provarlo."
          }
        }
      }
    },
    "「いんてれsちんg」→「interesting」のように、ローマ字日本語入力中も英語への変換候補を表示します。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows English candidates while typing Japanese with romaji (QWERTY), e.g., 'いんてれsちんg' → 'interesting'."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra candidati in inglese anche durante l'input in giapponese con romaji (QWERTY), ad esempio «いんてれsちんg → interesting»."
          }
        }
      }
    },
    "「エフォート」について" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
