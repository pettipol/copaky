    "設定" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni"
          }
        }
      }
    },
    "設定 ▸ 「イタリア語を使う」をオンにし、QWERTYの言語キーで「IT」を選びます。第一優先言語がイタリア語の端末では初期設定がオンです。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Settings ▸ “Use Italian”, then choose IT with the QWERTY language key. It is on by default when Italian is the device’s first preferred language."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva l'opzione Impostazioni ▸ «Usa l'italiano», quindi scegli IT con il tasto lingua QWERTY. È attiva per impostazione predefinita quando l'italiano è la prima lingua preferita del dispositivo."
          }
        }
      }
    },
    "設定アプリで「Copaky」▸「ほかのAppからペースト」▸「許可」の順に進みます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the Settings app, go to Copaky ▸ Paste from Other Apps ▸ Allow."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nell'app Impostazioni, vai su Copaky ▸ Incolla da altre app ▸ Consenti."
          }
        }
      }
    },
    "設定アプリで「一般」▸「キーボード」▸「キーボード」▸「Copaky」▸「フルアクセスを許可」をオンにします。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the Settings app, go to General ▸ Keyboard ▸ Keyboards ▸ Copaky and turn on Allow Full Access."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nell'app Impostazioni, vai su Generali ▸ Tastiera ▸ Tastiere ▸ Copaky e attiva Consenti accesso completo."
          }
        }
      }
    },
    "設定アプリで「一般」▸「キーボード」▸「キーボード」▸「新しいキーボードを追加」▸「Copaky」の順に進みます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the Settings app, go to General ▸ Keyboard ▸ Keyboards ▸ Add New Keyboard ▸ Copaky."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nell'app Impostazioni, vai su Generali ▸ Tastiera ▸ Tastiere ▸ Aggiungi nuova tastiera ▸ Copaky."
          }
        }
      }
    },
    "設定アプリで「ほかのAppからペースト」を「許可」にすることで、ダイアログが出なくなります。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By allowing 'Paste from other apps' in Settings, you can avoid these dialogs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostando «Incolla da altre app» su «Consenti» nell'app Impostazioni, questo avviso non verrà più visualizzato."
          }
        }
      }
    },
    "設定アプリを開く" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings app"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri l'app Impostazioni"
          }
        }
      }
    },
    "設定からいつでも送信の提案を停止できます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can disable send suggestions anytime from Settings."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi disattivare i suggerimenti di invio in qualsiasi momento dalle Impostazioni."
          }
        }
      }
    },
    "設定する" : {
      "localizations" : {
        "en" : {
