# Copaky machine-local signing (personal DEVELOPMENT_TEAM — see Copaky.xcconfig)
# NOT root-anchored: a copy in a subdirectory must be ignored too.
Copaky.local.xcconfig
*.local.xcconfig

# Credential-shaped files — none has ever been tracked and none should be. This is
# defense in depth against a stray `git add .`, not a substitute for the gitleaks
# pre-commit hook in .githooks/. Real signing material lives outside every repo.
*.p8
*.p12
*.pem
*.key
*.mobileprovision
*.certSigningRequest
*.env
.env.*
# Release artefacts (they embed the provisioning profile and the team identifier)
*.xcarchive/
ExportOptions*.plist

# azooKey Settings
/Gen/generated/*.gen
/Keyboard/Dictionary/*.binary
/Keyboard/Dictionary/cb/*.binary
/Keyboard/Dictionary/p/*.csv
/Keyboard/Dictionary/louds/*.louds
/Keyboard/Dictionary/louds/*.loudschars2
/Keyboard/Dictionary/louds/*.loudstxt3
/Keyboard/Dictionary/louds/*.chid
AzooKey-dict
Package.resolved
.swiftpm
*.DS_Store
__MACOSX/

