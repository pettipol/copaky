#!/usr/bin/env bash
# Copaky pre-commit gate — scans the STAGED DIFF for secrets before they enter local history.
#
# Why pre-commit and not just pre-push: once a commit containing a secret reaches a PUBLIC
# repository, rewriting history does not un-publish it. Forks, clones and platform caches keep
# the old objects, so the only real remedy is rotating the secret. Catching it here — before it
# is even a commit — is the only cheap moment.
#
# Note on the existing pre-push hook: it runs the local CI (build + tests). It is NOT a secret
# gate and never was. Before this file, the only secret gate in the whole chain was GitHub's
# server-side push protection.
#
# Enable on a fresh clone:  git config core.hooksPath .githooks
# Bypass (deliberately):    git commit --no-verify
set -uo pipefail

if command -v gitleaks >/dev/null 2>&1; then
  # `gitleaks git --staged` is the SUPPORTED spelling on 8.x. The older `gitleaks protect
  # --staged` still executes but is deprecated and hidden (it is absent from `gitleaks --help`),
  # so it is not what this hook depends on.
  if ! gitleaks git --staged --redact --no-banner "$(git rev-parse --show-toplevel)"; then
    echo "✘ pre-commit BLOCKED: gitleaks flagged something in the staged changes."
    echo "  Inspect with: git diff --cached"
    echo "  If it is genuinely a false positive, commit with --no-verify and add a rule."
    exit 1
  fi
else
  # FAIL CLOSED. A hook that silently passes when its scanner is missing provides zero
  # protection exactly on the machines least likely to have it — a fresh clone, a new
  # contributor. Install gitleaks, or opt out explicitly and on the record.
  echo "✘ pre-commit BLOCKED: gitleaks is not installed, so staged changes were NOT scanned."
  echo "  Install it:  brew install gitleaks"
  echo "  Or bypass deliberately:  COPAKY_ALLOW_NO_GITLEAKS=1 git commit …"
  [ "${COPAKY_ALLOW_NO_GITLEAKS:-0}" = "1" ] || exit 1
  echo "⚠ COPAKY_ALLOW_NO_GITLEAKS=1 set — proceeding WITHOUT a secret scan."
fi

# Home-directory path gate. This is the one leak class this repo has actually had: a personal
# /Users/<username>/… path baked into a tracked file (gitleaks does not flag it — it is not a
# secret, just a name). Fail closed on any STAGED file whose content matches. Placeholders like
# /Users/YOUR_NAME are deliberately excluded (uppercase first segment character).
HOME_PATH_RE='/Users/[a-z][A-Za-z0-9._-]*'
leak_found=0
while IFS= read -r -d '' f; do
  # Skip binary files: `git diff --cached --numstat` reports "-" for add/del counts on them.
  case "$(git diff --cached --numstat -- "$f" | cut -f1)" in
    -) continue ;;
  esac
  # Read the INDEX blob (what will be committed), not the working tree. No `grep -q` here: with
  # `pipefail` an early match makes grep exit first, `git show` gets SIGPIPE, the pipeline
  # reports 141 and a REAL hit reads as "absent" (reproduced by the Codex counter-review on the
  # 363 KB string catalog). Consume the whole stream and test the captured output instead.
  hits="$(git show ":$f" 2>/dev/null | grep -nE "$HOME_PATH_RE" || true)"
  if [ -n "$hits" ]; then
    echo "  ✘ $f"
    echo "$hits" | head -3 | sed 's/^/      /'
    leak_found=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "$leak_found" = 1 ]; then
  echo "✘ pre-commit BLOCKED: staged file(s) above contain an absolute home-directory path (/Users/<name>/…)."
  echo "  Use a placeholder (e.g. /Users/YOUR_NAME) or a relative/~ path instead."
  exit 1
fi

exit 0
