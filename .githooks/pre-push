#!/usr/bin/env bash
# Copaky pre-push gate — runs the FAST local CI (build MainApp + ClipboardHistoryManagerTests)
# before every push, replacing the disabled hosted macOS CI. Bypass with:  git push --no-verify
#
# Enable on a fresh clone:  git config core.hooksPath .githooks
set -uo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"      # repo root (.githooks/..)
CI="$REPO/scripts/ci-local.sh"
if [ -x "$CI" ]; then
  echo "⟳ pre-push: running fast local CI — bypass with 'git push --no-verify'…"
  if ! "$CI" --fast; then
    echo "✘ pre-push BLOCKED: local CI failed. Fix, or push with --no-verify."
    exit 1
  fi
else
  echo "⚠ pre-push: local CI not found at $CI — skipping."
fi
exit 0
