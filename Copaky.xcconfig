// Copaky — shared build configuration (applied to the Debug and Release
// configurations at project level via baseConfigurationReference).
//
// Machine-specific signing lives in Copaky.local.xcconfig (gitignored).
// To build on a physical device, create that file next to this one with your
// own Apple Developer team:
//
//     DEVELOPMENT_TEAM = YOUR_TEAM_ID
//
// Simulator builds work without it. See CONTRIBUTING.md.

#include? "Copaky.local.xcconfig"
